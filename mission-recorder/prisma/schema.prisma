generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model MissionSession {
  id                 String   @id @default(uuid())
  missionName        String
  missionId          String
  uavId              String
  platform           String
  startTime          DateTime
  endTime            DateTime?
  durationSeconds    Int?
  status             String // RUNNING, SUCCESS, ABORTED, FAILED
  initialFuelKg      Float?
  initialHealthScore Float?
  initialRulHours    Float?
  
  maxAltitude        Float?
  totalDistance      Float?
  fuelConsumed       Float?
  avgEngineHealth    Float?
  finalEngineHealth  Float?
  finalRulHours      Float?
  missionSuccessRate Float?

  telemetryHistory   TelemetryHistory[]
  missionEvents      MissionEvent[]
  faultHistories     FaultHistory[]
  aiInterventions    AiIntervention[]
  postFlightAnalysis PostFlightAnalysis?
}

model TelemetryHistory {
  id               String   @id @default(uuid())
  missionSessionId String
  timestamp        DateTime
  latitude         Float
  longitude        Float
  altitude         Float
  groundSpeed      Float
  heading          Float
  
  rpm              Float
  chtAvg           Float
  egtAvg           Float
  oilTemp          Float
  oilPressure      Float
  turboBoost       Float
  manifoldPressure Float
  
  fuelRemaining    Float
  engineHealth     Float
  rulHours         Float
  missionPhase     String 
  
  missionSession   MissionSession @relation(fields: [missionSessionId], references: [id], onDelete: Cascade)

  @@index([timestamp(sort: Desc)])
}

model MissionEvent {
  id               String   @id @default(uuid())
  missionSessionId String
  timestamp        DateTime
  eventType        String 
  severity         String 
  title            String
  description      String?

  missionSession   MissionSession @relation(fields: [missionSessionId], references: [id], onDelete: Cascade)
}

model FaultHistory {
  id                String   @id @default(uuid())
  missionSessionId  String
  faultType         String
  severity          String
  affectedSystems   String
  injectedAt        DateTime
  detectedAt        DateTime?
  recoveredAt       DateTime?
  impactDescription String?
  aiResponse        String?
  outcome           String?

  missionSession    MissionSession @relation(fields: [missionSessionId], references: [id], onDelete: Cascade)
}

model AiIntervention {
  id               String   @id @default(uuid())
  missionSessionId String
  timestamp        DateTime
  actionType       String
  reason           String
  confidenceScore  Float
  outcome          String?

  missionSession   MissionSession @relation(fields: [missionSessionId], references: [id], onDelete: Cascade)
}

model PostFlightAnalysis {
  id               String   @id @default(uuid())
  missionId        String   @unique
  missionDuration  Float
  distanceCovered  Float
  averageAltitude  Float
  maximumAltitude  Float
  averageRPM       Float
  maximumRPM       Float
  averageCHT       Float
  maximumCHT       Float
  averageEGT       Float
  maximumEGT       Float
  fuelConsumed     Float
  engineHealth     Float
  missionStatus    String
  createdAt        DateTime @default(now())

  missionSession   MissionSession @relation(fields: [missionId], references: [id], onDelete: Cascade)
}

model AntiGravityExperiment {
  id           String   @id @default(uuid())
  name         String
  status       String
  startTime    DateTime @default(now())
  endTime      DateTime?
  powerLevel   Float
  coreTemp     Float
  logs         AntiGravityEvent[]
  telemetry    AntiGravityTelemetry[]
}

model AntiGravityTelemetry {
  id           String   @id @default(uuid())
  experimentId String
  timestamp    DateTime @default(now())
  powerDrawKw  Float
  coreTempC    Float
  gravMetric   Float
  stability    Float

  experiment   AntiGravityExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
}

model AntiGravityEvent {
  id           String   @id @default(uuid())
  experimentId String
  timestamp    DateTime @default(now())
  eventType    String
  message      String
  severity     String

  experiment   AntiGravityExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
}

